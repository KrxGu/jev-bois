#!/usr/bin/env bash
# Helper for the isolated buildathon container (`jev-box`). Run from anywhere:
#   container/jev build             build the image and (re)create the container
#   container/jev login             log Claude Code in, inside the container only (/login, then /exit)
#   container/jev connect           failproofai config with the key from failproofai/.env (key never on a command line)
#   container/jev setup             buildathon setup (trust agent folders) + doctor
#   container/jev doctor            buildathon doctor
#   container/jev status            failproofai config --status + daemon state
#   container/jev test [scenario]   offline policy rig (no LLM)
#   container/jev run itsm ITSM-02  a real agent run (Claude Code + Haiku 4.5, policies enforced, session uploaded)
#   container/jev replay itsm       replay the newest run through your current policies
#   container/jev unlock <phrase>   open the sealed final round (the passphrase announced at T-40)
#   container/jev finals itsm [N]   run every [final] task of an agent exactly once, N in parallel (default 4)
#   container/jev live              (re)start the live trace viewer -> http://localhost:4777
#   container/jev shell             bash inside the container
#   container/jev logs              daemon + systemctl-shim logs
#   container/jev down              stop the container (state is kept)
#   container/jev reset             remove the container AND its home volume (logs out, wipes failproofai config)
set -euo pipefail

IMAGE=jev-buildathon:local
BOX=jev-box
VOLUME=jev-home
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # ~/Desktop/code/buildathon
PINNED_MODEL=claude-haiku-4-5   # the agents' pinned model (see .claude/settings.json)
KEYFILE="${JEV_KEYFILE:-$ROOT/failproofai/.env}"

up() {
  if ! docker container inspect "$BOX" >/dev/null 2>&1; then
    docker run -d --init --name "$BOX" --restart unless-stopped \
      -p 127.0.0.1:4777:4777 \
      -v "$ROOT:/work" -v "$VOLUME:/home/node" -w /work "$IMAGE" >/dev/null
  elif [ "$(docker inspect -f '{{.State.Running}}' "$BOX")" != true ]; then
    docker start "$BOX" >/dev/null
  fi
}

ex() {
  up
  local tty=()
  [ -t 0 ] && [ -t 1 ] && tty=(-it)
  docker exec ${tty[@]+"${tty[@]}"} -u node -w /work "$BOX" "$@"
}

# Every final-round session counts (averaged), so each [final] task runs once. A task that already
# has a transcript is skipped unless --again is given. Run output goes to finals/<agent>/<task>.txt.
finals() {
  local agent="${1:-}" par="${2:-4}" again="${3:-}"
  [[ "$agent" =~ ^[a-z]+$ ]] || { echo "usage: container/jev finals <agent> [parallel=4] [--again]" >&2; exit 2; }
  [[ "$par" =~ ^[1-8]$ ]] || { echo "parallel must be 1-8" >&2; exit 2; }
  local dir="$ROOT/jev-buildathon/agents/$agent-agent" out="$ROOT/finals/$agent"
  [ -f "$dir/final.json" ] || { echo "Final round not unlocked yet: container/jev unlock <passphrase>" >&2; exit 2; }
  local f n=0
  for f in "$dir"/.failproofai/policies/*policies.mjs; do
    [ -f "$f" ] || continue
    ex node --check "/work/${f#"$ROOT"/}" || { echo "syntax error in $f: fix it before running finals" >&2; exit 2; }
    n=$((n + $(grep -c "customPolicies.add" "$f" || true)))
  done
  [ "$n" -gt 0 ] || { echo "No policies registered for $agent: refusing to run finals on the untouched agent" >&2; exit 2; }
  local ids todo=()
  ids=$(ex node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).tasks.map((t) => t.id).join(" "))' "/work/jev-buildathon/agents/$agent-agent/final.json")
  for id in $ids; do
    [[ "$id" =~ ^[A-Za-z0-9-]+$ ]] || { echo "skip odd task id: $id" >&2; continue; }
    if [ "$again" != "--again" ] && ls "$dir/.runs/transcripts/$id-claude-"*.jsonl >/dev/null 2>&1; then
      echo "skip  $id (already run; add --again to run it again)"; continue
    fi
    todo+=("$id")
  done
  [ "${#todo[@]}" -gt 0 ] || { echo "Nothing to run."; return 0; }
  echo "$agent: ${#todo[@]} final task(s), $n policies loaded, $par in parallel. Watch http://localhost:4777"
  mkdir -p "$out"; up
  # xargs appends the task id last: $0 box, $1 agent, $2 output dir, $3 model, $4 task id.
  printf '%s\n' "${todo[@]}" | xargs -P "$par" -n 1 sh -c '
    echo "start $4"
    docker exec -u node -w /work "$0" node jev-buildathon/bin/buildathon.mjs run "$1" "$4" --model "$3" >"$2/$4.txt" 2>&1
    echo "done  $4 (exit $?)"' "$BOX" "$agent" "$out" "$PINNED_MODEL"
  echo; echo "Summary (full output in finals/$agent/):"
  for id in "${todo[@]}"; do
    local o="$out/$id.txt"
    printf '  %-12s executed %2s  failed %2s  blocked %2s  | %s\n' "$id" \
      "$(grep -c '•' "$o" || true)" "$(grep -c '✗' "$o" || true)" "$(grep -c '⊘' "$o" || true)" \
      "$(grep -m1 'Agent:' "$o" | cut -c1-110 || true)"
  done
}

cmd="${1:-shell}"; shift || true
case "$cmd" in
  build)
    DOCKER_BUILDKIT=1 docker build --secret "id=npmrc,src=$HOME/.npmrc" -t "$IMAGE" "$ROOT/container"
    docker rm -f "$BOX" >/dev/null 2>&1 || true
    up; echo "jev-box is up on the new image" ;;
  login)   ex claude ;;
  connect)
    [ -f "$KEYFILE" ] || { echo "No key file at $KEYFILE" >&2; exit 2; }
    up
    # docker reads the file; the value exists only in this exec's environment.
    docker exec -u node -w /work --env-file "$KEYFILE" "$BOX" \
      sh -c 'export FAILPROOFAI_CLOUD_TOKEN="${FAILPROOFAI_CLOUD_TOKEN:-${KEY:-}}"; unset KEY; exec failproofai config "$@"' _ "$@" ;;
  setup)   ex node jev-buildathon/bin/buildathon.mjs setup; ex node jev-buildathon/bin/buildathon.mjs doctor ;;
  doctor)  ex node jev-buildathon/bin/buildathon.mjs doctor ;;
  status)  ex failproofai config --status; ex systemctl status "failproofaid@node" || true ;;
  test)    ex node harness/scenario.mjs itsm "$@" ;;
  run)     # A work Claude login can bring org-managed settings that force claude-opus-5-5 over the agent's
           # pinned model, and sessions on another model are excluded from scoring. Pin it explicitly.
           case " $* " in *" --model "*|*" --harness codex "*) ex node jev-buildathon/bin/buildathon.mjs run "$@" ;;
             *) ex node jev-buildathon/bin/buildathon.mjs run "$@" --model "$PINNED_MODEL" ;; esac ;;
  replay)  ex node harness/replay.mjs "${1:-itsm}" latest ;;
  unlock)  [ -n "${1:-}" ] || { echo "usage: container/jev unlock <passphrase>" >&2; exit 2; }
           ex node jev-buildathon/bin/buildathon.mjs unlock "$1" ;;
  finals)  finals "$@" ;;
  shell)   ex bash ;;
  live)    up
           docker exec -u node "$BOX" sh -c 'pkill -f "[h]arness/live/server.mjs" || true'
           docker exec -d -u node -w /work "$BOX" sh -c 'exec node harness/live/server.mjs >>/tmp/live.log 2>&1'
           sleep 1; echo "live traces: http://localhost:4777" ;;
  logs)    ex sh -c 'tail -n 40 /tmp/failproofaid@node.log 2>/dev/null; echo "--- shim"; tail -n 20 /tmp/systemctl-shim.log 2>/dev/null' ;;
  down)    docker stop "$BOX" >/dev/null && echo stopped ;;
  reset)   docker rm -f "$BOX" >/dev/null 2>&1 || true; docker volume rm "$VOLUME" ;;
  *) sed -n '2,20p' "$0"; exit 2 ;;
esac
